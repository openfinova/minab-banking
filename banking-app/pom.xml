			<artifactId>banking-common-lib</artifactId>
		</dependency>
		<dependency>
			<groupId>com.openfinova</groupId>
			<artifactId>setup-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.openfinova</groupId>
