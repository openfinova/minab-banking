# Normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly mark Java/XML as text
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.properties text eol=lf

# Binaries — never touch
*.jar  binary
*.png  binary
*.jpg  binary
