# Copy to .env (gitignored) and adjust for your environment.
# These back the Keycloak migration; defaults are dev-only and MUST be changed for any
# shared/staging/prod deployment.

# --- Keycloak admin bootstrap (master realm console at :8081) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Dev banking staff login (openfinova realm, seeded by banking-app DataInitializer) ---
# Username: admin  Password: Openfinova123!  (must match Keycloak password policy)

# --- OAuth client secrets (referenced from keycloak/realm/openfinova.yaml) ---
STAFF_PORTAL_CLIENT_SECRET=staff-portal-secret
CUSTOMER_PORTAL_CLIENT_SECRET=customer-portal-secret
STAFF_APP_CLIENT_SECRET=staff-secret

# --- Banking <-> Keycloak integration ---
# Shared secret guarding the internal claims endpoint that the Keycloak SPI calls.
BANKING_INTERNAL_TOKEN=local-dev-internal-token-change-me
# Service-account client banking-app uses to provision users via the Keycloak Admin API.
KEYCLOAK_PROVISIONING_CLIENT_ID=banking-provisioning
KEYCLOAK_PROVISIONING_CLIENT_SECRET=banking-provisioning-secret
